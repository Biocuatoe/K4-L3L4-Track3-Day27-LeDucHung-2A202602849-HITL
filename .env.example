# LLM provider: "groq" or "openrouter" (both OpenAI-compatible).
# If LLM_PROVIDER is unset, OpenRouter is used when OPENROUTER_API_KEY is set, else Groq.
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter alternative (keep LLM_BASE_URL/LLM_MODEL consistent with the provider):
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1

# SQLite database path (optional — defaults to ./hitl_audit.db in CWD)
# HITL_DB_PATH=hitl_audit.db

# GitHub Personal Access Token — REQUIRED.
#
# The agent calls the GitHub REST API directly. Generate a token at:
#   https://github.com/settings/tokens/new
# Scopes: tick `public_repo` (enough for VinUni-AI20k/PR-Demo — it's a public repo).
#
# Posting a top-level PR comment works for any authenticated user on a public repo.
# Formal reviews (Approve/Request-changes) would need collaborator status on the target.
GITHUB_TOKEN=

# Optional: GitHub username recorded as reviewer_id on human audit events.
# If unset, the login that owns GITHUB_TOKEN is looked up (falls back to "unknown").
# GITHUB_USER=
